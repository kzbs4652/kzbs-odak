<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgAppIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/app_icon_description"
            android:src="@drawable/ic_kzbs_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Uygulama Adı"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppPackage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="com.example.app"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="7dp"
        app:chipSpacingHorizontal="4dp"
        app:chipSpacingVertical="0dp"
        app:singleLine="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLockApp"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:checkable="true"
            android:text="@string/app_action_lock"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            app:checkedIcon="@drawable/ic_check"
            app:checkedIconTint="@color/text_primary"
            app:chipBackgroundColor="@color/app_action_chip_background"
            app:chipIcon="@drawable/ic_lock"
            app:chipIconTint="@color/accent_blue"
            app:chipStrokeColor="@color/app_action_chip_stroke"
            app:chipStrokeWidth="1dp"
            app:ensureMinTouchTargetSize="false" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMuteNotifications"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:checkable="true"
            android:text="@string/app_action_mute"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            app:checkedIcon="@drawable/ic_check"
            app:checkedIconTint="@color/text_primary"
            app:chipBackgroundColor="@color/app_action_chip_background"
            app:chipIcon="@drawable/ic_bell_off"
            app:chipIconTint="@color/accent_blue_light"
            app:chipStrokeColor="@color/app_action_chip_stroke"
            app:chipStrokeWidth="1dp"
            app:ensureMinTouchTargetSize="false" />
    </com.google.android.material.chip.ChipGroup>
</LinearLayout>
